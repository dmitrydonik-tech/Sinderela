# ==========================================================================
#  ЗАГОЛОВКИ ОТВЕТА для хостинга. Формат одинаковый у Cloudflare Pages
#  и у Netlify — файл кладётся в корень репозитория и работает сам.
#
#  ⚠ На GitHub Pages НЕ работает: он свои заголовки задавать не даёт
#  и жёстко отдаёт всему Cache-Control: max-age=600 (10 минут).
#  Ради этого файла и затевается переезд (см. HOSTING-MIGRATION.md).
#
#  Порядок важен: сначала общее правило, потом узкие — они
#  переопределяют Cache-Control для своих папок.
# ==========================================================================


# --- Безопасность: на все ответы ---------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()


# --- HTML: НЕ кешируем -------------------------------------------------
# Чтобы правки сайта долетали до людей сразу, а не через сутки.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate


# --- Картинки и видео: 30 дней ----------------------------------------
# ПОЧЕМУ не год: часть файлов подключена БЕЗ версии в ссылке —
#   hero-combined.mp4, hero-poster.webp, crest.webp, crest-dark.webp,
#   footer-logo.webp, firstline-service.webp, og-image.jpg, logo-full.png,
#   favicon-32.png, apple-touch-icon.png
# Если поставить год и заменить такой файл — у людей до года будет старый.
# 30 дней — уже в 4000 раз лучше нынешних 10 минут, но без риска.
#
# ⚠ ПРАВИЛО НА БУДУЩЕЕ: заменяешь файл из этого списка —
#   ОБЯЗАТЕЛЬНО добавь версию в ссылку в index.html (?v=2) или переименуй файл.
#   Иначе люди со старым кешем не увидят обновление.
/assets/*
  Cache-Control: public, max-age=2592000


# --- Иконки товаров: год + immutable ----------------------------------
# Безопасно: в ссылке всегда стоит ?v=ICONVER, а при замене иконок
# ICONVER бампается скриптом tools/bump-iconver.mjs → URL меняется.
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# --- Шрифты: год + immutable ------------------------------------------
# Безопасно: содержимое не меняется, начертание и набор зашиты в имя файла.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable


